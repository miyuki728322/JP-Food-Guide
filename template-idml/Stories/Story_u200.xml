    </ParagraphStyleRange>
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/u_SpecValue">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
        <Content>Masamoto · Konosuke · Takamura · Sakai Takayuki</Content>
        <Br/>
      </CharacterStyleRange>
    </ParagraphStyleRange>
